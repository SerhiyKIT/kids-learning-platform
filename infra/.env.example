POSTGRES_DB=kidlearn
POSTGRES_USER=kidlearn
POSTGRES_PASSWORD=changeme

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# LLM lesson generation (ua.kidlearn.aipipeline). "stub" = deterministic fake, no network.
# The real Anthropic provider is wired only when KIDLEARN_LLM_PROVIDER=anthropic AND
# KIDLEARN_LLM_API_KEY is non-blank. Put the real key only in infra/.env (gitignored), never here.
KIDLEARN_LLM_PROVIDER=stub
KIDLEARN_LLM_API_KEY=
KIDLEARN_LLM_MODEL=claude-sonnet-5-5

# TTS voicing (ua.kidlearn.aipipeline). "stub" = deterministic fake, no network.
# The real Google Cloud Text-to-Speech provider is wired only when KIDLEARN_TTS_PROVIDER=google
# AND KIDLEARN_TTS_API_KEY is non-blank. Put the real key only in infra/.env (gitignored), never
# here. A blank KIDLEARN_TTS_VOICE lets Google pick a voice for KIDLEARN_TTS_LANGUAGE.
KIDLEARN_TTS_PROVIDER=stub
KIDLEARN_TTS_API_KEY=
KIDLEARN_TTS_LANGUAGE=uk-UA
KIDLEARN_TTS_VOICE=
