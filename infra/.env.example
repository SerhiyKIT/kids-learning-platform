POSTGRES_PASSWORD=changeme

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# LLM lesson generation (ua.kidlearn.aipipeline). "stub" = deterministic fake, no network.
# The real Anthropic provider is wired only when KIDLEARN_LLM_PROVIDER=anthropic AND
# KIDLEARN_LLM_API_KEY is non-blank. Put the real key only in infra/.env (gitignored), never here.
KIDLEARN_LLM_PROVIDER=stub
KIDLEARN_LLM_API_KEY=
KIDLEARN_LLM_MODEL=claude-sonnet-5-5
