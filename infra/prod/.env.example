# Production settings for infra/prod/docker-compose.yml. Copy to infra/prod/.env (gitignored),
# fill in EVERY value, then `chmod 600 .env`. Never commit the filled-in file. See docs/DEPLOY.md.

# ---- Release and domain -------------------------------------------------------------------
# Image tag to run, e.g. v1.0.0 (a git tag built by .github/workflows/release.yml).
IMAGE_TAG=
# Public host name (DNS A record → this server), e.g. kids.example.org
DOMAIN=
# Public origin used in emailed links: https://${DOMAIN}
APP_BASE_URL=
# Let's Encrypt account email (expiry warnings).
LETSENCRYPT_EMAIL=

# ---- PostgreSQL ---------------------------------------------------------------------------
POSTGRES_DB=kidlearn
POSTGRES_USER=kidlearn
# openssl rand -base64 32 | tr -d '/+=' | head -c 40
POSTGRES_PASSWORD=
# The backend connects with these (DATASOURCE_URL/USERNAME/PASSWORD are derived from the
# POSTGRES_* values in docker-compose.yml — nothing extra to set here).

# ---- MinIO (voice-line audio) -------------------------------------------------------------
# openssl rand -hex 12
MINIO_ROOT_USER=
# openssl rand -base64 32 | tr -d '/+=' | head -c 40
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=kidlearn-assets

# ---- Admin security -----------------------------------------------------------------------
# AES-256 key for admin TOTP secrets: openssl rand -base64 32
# Keep a copy in your password manager: losing it means every admin re-enrols 2FA.
TWOFA_ENC_KEY=
# One-time first-admin token: openssl rand -hex 32. Remove (leave empty) once the first admin
# exists — the endpoint closes permanently anyway.
ADMIN_BOOTSTRAP_TOKEN=

# ---- Email (SMTP of your mail provider) ----------------------------------------------------
SMTP_HOST=
# 587 with STARTTLS (SMTP_STARTTLS=true, SMTP_SSL=false) or 465 with SSL (the opposite).
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
# Leave true for any real provider.
SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address on your domain (SPF/DKIM/DMARC set up for it), e.g. no-reply@kids.example.org
MAIL_FROM=

# ---- Sessions -----------------------------------------------------------------------------
# Inactivity timeout of an adult's session (child mode keeps it alive while playing).
SESSION_TIMEOUT=60m

# ---- AI lesson generation (Anthropic) — optional; "stub" means no real AI -------------------
KIDLEARN_LLM_PROVIDER=stub
KIDLEARN_LLM_API_KEY=
KIDLEARN_LLM_MODEL=claude-sonnet-5-5
LLM_MAX_ATTEMPTS=2

# ---- Text-to-speech (Google Cloud TTS) — optional; "stub" means silent placeholder audio ------
KIDLEARN_TTS_PROVIDER=stub
KIDLEARN_TTS_API_KEY=
KIDLEARN_TTS_LANGUAGE=uk-UA
KIDLEARN_TTS_VOICE=
# Changes the cache key of synthesized audio; change it when switching voice/provider.
TTS_VOICE_ID=default

# ---- JVM (optional) -----------------------------------------------------------------------
# JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
